# ============================================================
# DTCK AI Investment Platform — Environment Example
# Copy to .env and fill real values. NEVER commit .env.
# ============================================================

# --- PostgreSQL / TimescaleDB ---
POSTGRES_USER=dtck
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dtck
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://dtck:change_me@localhost:5432/dtck

# --- Qdrant (vector DB) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- LLM provider abstraction (ADR-005) ---
LLM_PROVIDER=openai          # openai | anthropic | local (ollama/vllm) | mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
# local/Ollama only: turn off the thinking block of hybrid models (Qwen3.5…) so
# agent runs stay inside the §45 latency budget. Set true to keep reasoning.
LLM_THINK=false
# Example: local Ollama reachable from the containers
# LLM_PROVIDER=local
# LLM_MODEL=qwen3.5
# LLM_BASE_URL=http://host.docker.internal:11434

# --- Embeddings (Phase 4 / RAG) ---
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# --- App ---
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501
WORKER_INTERVAL_MINUTES=60

# --- Data sources (fill during Phase 1; no secrets in repo) ---
# Provider registry: configs/sources.yaml (design: docs/DATA_SOURCES.md)
MARKET_DATA_PROVIDER=ssix_finipro
MARKET_DATA_API_KEY=
FUNDAMENTAL_DATA_PROVIDER=ssix_finipro
NEWS_PROVIDER=cafef
NEWS_API_KEY=

# Provider-specific credentials (names only; see docs/DATA_SOURCES.md §6)
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=
SSI_API_URL=https://fc-data.ssi.com.vn
FINIPRO_ACCESS_TOKEN=
VIETSTOCK_API_KEY=
TRADINGECONOMICS_API_KEY=

# --- Scoring (baseline §12) ---
SCORING_VERSION=baseline_1.0

# --- Data quality gate (§39, T005) ---
# Batches scoring below this are flagged below_threshold and not used downstream.
DATA_QUALITY_THRESHOLD=80.0

# --- API market-data source (read path) ---
# memory = deterministic in-process fixture (default; API and unit tests need no DB)
# db     = read TimescaleDB through apps/api/services/db_market.py
# auto   = use the DB when it answers AND table `prices` already has rows, else memory
MARKET_DATA_SOURCE=memory

# --- API-key auth (spec §32) ---
# When set: every POST/PUT/PATCH/DELETE under /api/v1/ (except /auth/login) and
# GET /metrics require `Authorization: Bearer <key>`. Empty = disabled (demo/tests).
API_AUTH_KEY=

# --- User JWT / RBAC (spec §3/§32, T015b) ---
# HMAC-SHA256 secret for access/refresh tokens issued by POST /api/v1/auth/login.
# Empty = demo token strings + offline ADMIN identity (unit tests). Production:
# generate one (e.g. `python -c "import secrets;print(secrets.token_urlsafe(32))"`).
AUTH_JWT_SECRET=
AUTH_JWT_TTL_SECONDS=3600
AUTH_REFRESH_TTL_SECONDS=604800

# --- Worker scheduler (APScheduler, timezone Asia/Ho_Chi_Minh) ---
SCHEDULER_JOBS_ENABLED=true
SCHEDULER_NEWS_SOURCE=cafef
SCHEDULER_NEWS_INTERVAL_MINUTES=15
# Primary EOD source. The job then walks `fallback_chains.market` from
# configs/sources.yaml (yahoo → vndirect → tcbs → dsc) when it fails / returns
# no rows, so SSI FastConnect is primary and Yahoo is the first fallback.
SCHEDULER_EOD_SOURCE=ssix_finipro
# Two sessions/day (ICT): ingest after each close (11:30 morning, 15:30 afternoon)
# and score 30 min later (12:00, 16:00). Hours are comma-separated lists.
SCHEDULER_EOD_CRON_HOURS=11,15
SCHEDULER_EOD_CRON_MINUTE=30
SCHEDULER_EOD_LOOKBACK_DAYS=7
# Index codes ingested by the same EOD run (SSI Market/DailyIndex); comma-separated.
# Leave empty to skip index ingestion (the VNINDEX/VN30 chart would then go stale).
SCHEDULER_EOD_INDICES=VNINDEX,VN30
# Keep the morning run's in-progress session snapshot (powers the 12:30 report and
# is always overwritten by the 15:30 close run). Set false to only ingest closed
# sessions, at the cost of a live noon report.
SCHEDULER_EOD_INCLUDE_INTRADAY_SESSION=true
# Close-of-day catch-up: re-runs the EOD ingestion only while prices/index_prices
# are behind the last closed session, so a vendor outage at 15:30 (SSI 502 on
# 2026-09-29, KI-014) is repaired before the 16:00 scoring and 16:30 report.
SCHEDULER_EOD_CATCHUP_HOUR=15
SCHEDULER_EOD_CATCHUP_MINUTE=50
# ICT cutoff that marks the afternoon session as closed; drives the catch-up
# window and the "provisional scores" warning in the scoring job.
SCHEDULER_SESSION_CLOSE_HOUR=15
SCHEDULER_SESSION_CLOSE_MINUTE=15
SCHEDULER_SCORING_CRON_HOURS=12,16
SCHEDULER_SCORING_CRON_MINUTE=0
SCHEDULER_STRATEGY_HOUR=17
SCHEDULER_STRATEGY_MINUTE=0
# Email report windows (08:00 / 12:30 / 16:30) live in the database
# (`email_schedule_configs`) and are editable on the dashboard; the worker
# re-reads them every SCHEDULER_EMAIL_SYNC_MINUTES without a restart.
SCHEDULER_EMAIL_SYNC_MINUTES=15
