# ============================================================
# DTCK AI Investment Platform — Environment Example
# Copy to .env and fill real values. NEVER commit .env.
# ============================================================

# --- PostgreSQL / TimescaleDB ---
POSTGRES_USER=dtck
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dtck
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://dtck:change_me@localhost:5432/dtck

# --- Qdrant (vector DB) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- LLM provider abstraction (ADR-005) ---
LLM_PROVIDER=openai          # openai | anthropic | local (ollama/vllm) | mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120

# --- Embeddings (Phase 4 / RAG) ---
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# --- App ---
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501
WORKER_INTERVAL_MINUTES=60

# --- Data sources (fill during Phase 1; no secrets in repo) ---
# Provider registry: configs/sources.yaml (design: docs/DATA_SOURCES.md)
MARKET_DATA_PROVIDER=ssix_finipro
MARKET_DATA_API_KEY=
FUNDAMENTAL_DATA_PROVIDER=ssix_finipro
NEWS_PROVIDER=cafef
NEWS_API_KEY=

# Provider-specific credentials (names only; see docs/DATA_SOURCES.md §6)
FINIPRO_ACCESS_TOKEN=
VIETSTOCK_API_KEY=
TRADINGECONOMICS_API_KEY=

# --- Scoring (baseline §12) ---
SCORING_VERSION=baseline_1.0

# --- Data quality gate (§39, T005) ---
# Batches scoring below this are flagged below_threshold and not used downstream.
DATA_QUALITY_THRESHOLD=80.0