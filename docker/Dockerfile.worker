# DTCK Worker image (schedulers, collectors, daily jobs)
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md alembic.ini ./
COPY src ./src
COPY apps ./apps
COPY configs ./configs
COPY database ./database
# [ml] extra: the worker runs train-model (scikit-learn/xgboost); [qdrant] = the
# Qdrant client only (news chunks are mirrored to the collection); [dev] keeps
# pytest/ruff/mypy available in this image.
RUN pip install --upgrade pip && pip install -e ".[dev,ml,qdrant]"

CMD ["python", "-m", "apps.worker.main"]