# DTCK API image
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# System deps (minimal)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install project (editable). [ml] = scikit-learn/xgboost — the API imports the
# ML layer via agent tools + the predictions endpoints; [dev] keeps pytest/ruff/
# mypy available in this image.
COPY pyproject.toml README.md ./
COPY src ./src
COPY apps ./apps
COPY database ./database
RUN pip install --upgrade pip && pip install -e ".[dev,ml]"

EXPOSE 8000

CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]